{
  "Masala": {
    "ConfigPath": "./config",
    "Database": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=app.db"
    },
    "Gerda": {
      "Enabled": true,
      "ModelPath": "./models",
      "OpenAiModel": "gpt-4"
    },
    "Features": {
      "TicketGenerator": false,
      "TicketGeneratorIntervalSeconds": 30,
      "EmailNotifications": false,
      "KnowledgeBase": true
    }
  },
  "OpenAI": {
    "ApiKey": "placeholder-key",
    "BaseUrl": "https://openrouter.ai/api/v1"
  },
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EmailSettings": {
    "Host": "imap.example.com",
    "Port": 993,
    "UseSsl": true,
    "Username": "user@example.com",
    "Password": "password",
    "DeleteProcessed": false
  },
  "TicketGenerator": {
    "Enabled": true,
    "IntervalSeconds": 30
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "event_exchange",
    "VirtualHost": "/"
  },
  "Agentic": {
    "ApiUrl": "http://localhost:3001"
  }
}