#!/bin/sh
# Prepare commit message hook
# Can be used to validate or auto-generate commit messages

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# Skip for merge commits, squash commits, etc.
if [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "squash" ]; then
    exit 0
fi

