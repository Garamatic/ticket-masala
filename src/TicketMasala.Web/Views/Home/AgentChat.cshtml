@{
    ViewData["Title"] = "AI Agent";
    var hasTicket = ViewBag.TicketId != null;
}

@section Styles {
<style>
    /* ─── Layout ─── */
    .agent-layout {
        display: flex;
        height: calc(100vh - 100px);
        min-height: 500px;
        background: var(--bg-primary);
        border-radius: var(--border-radius-lg);
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    /* ─── Sidebar ─── */
    .agent-sidebar {
        width: 260px;
        flex-shrink: 0;
        background: var(--bg-secondary);
        border-right: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        transition: width 0.3s ease;
    }
    .agent-sidebar.collapsed {
        width: 0;
        overflow: hidden;
        border-right: none;
    }
    .sidebar-header {
        padding: 1rem;
        border-bottom: 1px solid var(--border-color);
    }
    .sidebar-new-btn {
        width: 100%;
        padding: 0.5rem 0.75rem;
        border-radius: var(--border-radius);
        border: 1px dashed var(--border-color);
        background: var(--bg-primary);
        color: var(--text-primary);
        font-size: 0.85rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.375rem;
        transition: all 0.2s;
    }
    .sidebar-new-btn:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
        background: rgba(99, 102, 241, 0.05);
    }
    .sidebar-threads {
        flex: 1;
        overflow-y: auto;
        padding: 0.5rem;
    }
    .sidebar-threads::-webkit-scrollbar {
        width: 4px;
    }
    .sidebar-threads::-webkit-scrollbar-thumb {
        background: var(--border-color);
        border-radius: 2px;
    }
    .thread-item {
        padding: 0.625rem 0.75rem;
        border-radius: var(--border-radius);
        cursor: pointer;
        transition: all 0.15s;
        margin-bottom: 0.25rem;
        position: relative;
        user-select: none;
    }
    .thread-item:hover {
        background: var(--bg-primary);
    }
    .thread-item.active {
        background: rgba(99, 102, 241, 0.08);
        border: 1px solid rgba(99, 102, 241, 0.2);
    }
    .thread-item.active .thread-title {
        color: var(--color-primary);
        font-weight: 500;
    }
    .thread-title {
        font-size: 0.8rem;
        color: var(--text-primary);
        line-height: 1.4;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding-right: 1.5rem;
    }
    .thread-meta {
        font-size: 0.7rem;
        color: var(--text-tertiary);
        margin-top: 0.125rem;
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }
    .thread-delete {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: none;
        background: transparent;
        color: var(--text-tertiary);
        font-size: 0.65rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.2s;
    }
    .thread-item:hover .thread-delete {
        opacity: 1;
    }
    .thread-delete:hover {
        background: var(--color-danger);
        color: white;
    }
    .sidebar-empty {
        padding: 2rem 1rem;
        text-align: center;
        color: var(--text-tertiary);
        font-size: 0.8rem;
    }
    .sidebar-empty i {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
        display: block;
    }
    .sidebar-toggle {
        display: none;
        position: absolute;
        top: 50%;
        left: 0;
        width: 20px;
        height: 40px;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-left: none;
        border-radius: 0 4px 4px 0;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 100;
        color: var(--text-secondary);
        font-size: 0.65rem;
    }

    /* ─── Main Chat Area ─── */
    .agent-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        position: relative;
    }
    .chat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1.25rem;
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
        color: white;
        position: relative;
        overflow: hidden;
        flex-shrink: 0;
    }
    .chat-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 200px;
        height: 200px;
        background: rgba(255,255,255,0.08);
        border-radius: 50%;
        pointer-events: none;
    }
    .chat-header-left {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        z-index: 1;
    }
    .chat-header-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255,255,255,0.15);
        border: 2px solid rgba(255,255,255,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }
    .chat-header-title {
        font-weight: 600;
        font-size: 1rem;
        margin: 0;
        line-height: 1.3;
    }
    .chat-header-subtitle {
        font-size: 0.7rem;
        opacity: 0.8;
        margin: 0;
    }
    .chat-header-status {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.75rem;
        background: rgba(255,255,255,0.15);
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
        z-index: 1;
    }
    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #4ade80;
        animation: statusPulse 2s ease-in-out infinite;
    }
    @@keyframes statusPulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }
    .chat-header-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        z-index: 1;
    }
    .chat-header-btn {
        background: rgba(255,255,255,0.1);
        border: none;
        color: white;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.75rem;
        transition: background 0.2s;
    }
    .chat-header-btn:hover {
        background: rgba(255,255,255,0.25);
    }
    .model-switcher {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        background: rgba(255,255,255,0.1);
        border: none;
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
        font-size: 0.75rem;
        cursor: pointer;
        z-index: 1;
        transition: background 0.2s;
    }
    .model-switcher:hover {
        background: rgba(255,255,255,0.25);
    }
    .model-switcher select {
        background: transparent;
        border: none;
        color: white;
        font-size: 0.75rem;
        cursor: pointer;
        outline: none;
        padding-right: 0.25rem;
        max-width: 140px;
    }
    .model-switcher select option {
        background: var(--bg-primary);
        color: var(--text-primary);
    }
    .model-switcher i {
        font-size: 0.65rem;
        opacity: 0.8;
    }

    /* ─── Quick Actions ─── */
    .quick-actions {
        padding: 0.625rem 1.25rem;
        background: var(--bg-secondary);
        border-bottom: 1px solid var(--border-color);
        flex-shrink: 0;
    }
    .quick-actions-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-tertiary);
        margin-bottom: 0.375rem;
        font-weight: 600;
    }
    .quick-action-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.35rem 0.625rem;
        border-radius: 999px;
        font-size: 0.78rem;
        border: 1px solid var(--border-color);
        background: var(--bg-primary);
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.2s ease;
        margin: 0.125rem;
        white-space: nowrap;
    }
    .quick-action-chip:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
        background: rgba(99, 102, 241, 0.05);
        transform: translateY(-1px);
    }
    .quick-action-chip i {
        font-size: 0.65rem;
    }

    /* ─── Chat History ─── */
    .chat-history {
        flex: 1;
        overflow-y: auto;
        padding: 1.25rem;
        background: var(--bg-secondary);
        scroll-behavior: smooth;
        position: relative;
    }
    .chat-history::-webkit-scrollbar {
        width: 6px;
    }
    .chat-history::-webkit-scrollbar-track {
        background: transparent;
    }
    .chat-history::-webkit-scrollbar-thumb {
        background: var(--border-color);
        border-radius: 3px;
    }

    /* ─── Messages ─── */
    .message {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
        animation: messageIn 0.3s ease-out;
    }
    @@keyframes messageIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .message-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        flex-shrink: 0;
        margin-top: 2px;
    }
    .message-avatar.user {
        background: var(--color-primary);
        color: white;
        order: 2;
    }
    .message-avatar.agent {
        background: linear-gradient(135deg, var(--color-primary), #A855F7);
        color: white;
    }
    .message-body {
        max-width: 80%;
        display: flex;
        flex-direction: column;
    }
    .message-body.user {
        align-items: flex-end;
        order: 1;
    }
    .message-bubble {
        padding: 0.75rem 1rem;
        border-radius: 1rem;
        line-height: 1.5;
        font-size: 0.9rem;
        position: relative;
    }
    .message-bubble.user {
        background: var(--color-primary);
        color: white;
        border-bottom-right-radius: 0.25rem;
    }
    .message-bubble.agent {
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        border-bottom-left-radius: 0.25rem;
    }
    .message-meta {
        font-size: 0.7rem;
        color: var(--text-tertiary);
        margin-top: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .message-copy {
        opacity: 0;
        transition: opacity 0.2s;
        cursor: pointer;
        padding: 0.125rem 0.25rem;
        border-radius: 3px;
    }
    .message:hover .message-copy {
        opacity: 1;
    }
    .message-copy:hover {
        background: var(--bg-secondary);
    }
    .message-copy.copied {
        opacity: 1;
        color: var(--color-success);
    }

    /* ─── Tool Call Indicators ─── */
    .tool-indicator {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        background: rgba(99, 102, 241, 0.06);
        border: 1px solid rgba(99, 102, 241, 0.15);
        border-radius: 0.5rem;
        margin-bottom: 0.75rem;
        font-size: 0.8rem;
        color: var(--color-primary);
        max-width: 80%;
        animation: fadeIn 0.3s ease-out;
    }
    .tool-indicator i {
        font-size: 0.75rem;
    }
    .tool-indicator .tool-spinner {
        width: 12px;
        height: 12px;
        border: 2px solid rgba(99, 102, 241, 0.2);
        border-top-color: var(--color-primary);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .tool-indicator.done {
        background: rgba(74, 222, 128, 0.06);
        border-color: rgba(74, 222, 128, 0.2);
        color: var(--color-success);
    }
    .tool-indicator.done .tool-spinner {
        border: none;
        width: auto;
        height: auto;
        animation: none;
    }

    /* ─── Typing Indicator ─── */
    .typing-indicator {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
        animation: messageIn 0.3s ease-out;
    }
    .typing-dots {
        display: flex;
        gap: 0.25rem;
        padding: 0.75rem 1rem;
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        border-radius: 1rem;
        border-bottom-left-radius: 0.25rem;
    }
    .typing-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--color-primary);
        animation: typingBounce 1.4s ease-in-out infinite;
    }
    .typing-dot:nth-child(2) { animation-delay: 0.2s; }
    .typing-dot:nth-child(3) { animation-delay: 0.4s; }
    @@keyframes typingBounce {
        0%, 60%, 100% { transform: translateY(0); }
        30% { transform: translateY(-4px); }
    }
    .typing-label {
        font-size: 0.75rem;
        color: var(--text-tertiary);
    }

    /* ─── Empty State ─── */
    .chat-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        text-align: center;
        color: var(--text-tertiary);
        padding: 2rem;
    }
    .chat-empty-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        background: linear-gradient(135deg, var(--color-primary), #A855F7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .chat-empty-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
    }
    .chat-empty-text {
        font-size: 0.85rem;
        max-width: 400px;
        line-height: 1.6;
    }

    /* ─── Input Area ─── */
    .chat-input-area {
        padding: 0.75rem 1.25rem;
        background: var(--bg-primary);
        border-top: 1px solid var(--border-color);
        flex-shrink: 0;
    }
    .chat-input-wrapper {
        display: flex;
        align-items: flex-end;
        gap: 0.5rem;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 1rem;
        padding: 0.5rem 0.75rem;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .chat-input-wrapper:focus-within {
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }
    .chat-input {
        flex: 1;
        border: none;
        background: transparent;
        padding: 0.375rem 0.5rem;
        font-size: 0.9rem;
        color: var(--text-primary);
        resize: none;
        max-height: 120px;
        min-height: 24px;
        outline: none;
        line-height: 1.5;
    }
    .chat-input::placeholder {
        color: var(--text-tertiary);
    }
    .chat-send-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: none;
        background: var(--color-primary);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        flex-shrink: 0;
        font-size: 0.85rem;
    }
    .chat-send-btn:hover {
        background: var(--color-primary-dark);
        transform: scale(1.05);
    }
    .chat-send-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
    }
    .chat-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.25rem 0.5rem 0;
        font-size: 0.7rem;
        color: var(--text-tertiary);
    }
    .chat-toolbar-left {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }
    .chat-toolbar-btn {
        background: none;
        border: none;
        color: var(--text-tertiary);
        cursor: pointer;
        font-size: 0.7rem;
        padding: 0.125rem 0.25rem;
        border-radius: 3px;
        transition: color 0.2s;
    }
    .chat-toolbar-btn:hover {
        color: var(--color-primary);
    }
    .chat-toolbar-divider {
        width: 1px;
        height: 10px;
        background: var(--border-color);
    }

    /* ─── Markdown in messages ─── */
    .markdown-content p { margin: 0 0 0.5rem; }
    .markdown-content p:last-child { margin-bottom: 0; }
    .markdown-content ul, .markdown-content ol {
        padding-left: 1.2rem;
        margin: 0.5rem 0;
    }
    .markdown-content li { margin-bottom: 0.25rem; }
    .markdown-content code {
        background: rgba(99, 102, 241, 0.08);
        color: var(--color-primary-dark);
        padding: 0.15rem 0.35rem;
        border-radius: 4px;
        font-size: 0.85em;
        font-family: 'SFMono-Regular', Consolas, monospace;
    }
    .message-bubble.agent .markdown-content code {
        background: var(--bg-secondary);
        color: var(--color-primary);
    }
    .markdown-content pre {
        background: var(--bg-secondary);
        padding: 0.75rem;
        border-radius: 6px;
        overflow-x: auto;
        margin: 0.5rem 0;
        border: 1px solid var(--border-color);
    }
    .markdown-content pre code {
        background: none;
        padding: 0;
        color: var(--text-primary);
    }
    .markdown-content blockquote {
        border-left: 3px solid var(--color-primary);
        padding-left: 0.75rem;
        margin: 0.5rem 0;
        color: var(--text-secondary);
        font-style: italic;
    }
    .markdown-content h1, .markdown-content h2, .markdown-content h3, .markdown-content h4 {
        font-size: 1rem;
        margin: 0.75rem 0 0.5rem;
        font-weight: 600;
        color: var(--text-primary);
    }
    .markdown-content table {
        width: 100%;
        border-collapse: collapse;
        margin: 0.5rem 0;
        font-size: 0.85rem;
    }
    .markdown-content th, .markdown-content td {
        border: 1px solid var(--border-color);
        padding: 0.375rem 0.5rem;
        text-align: left;
    }
    .markdown-content th {
        background: var(--bg-secondary);
        font-weight: 600;
    }
    .markdown-content a {
        color: var(--color-primary);
        text-decoration: none;
    }
    .markdown-content a:hover {
        text-decoration: underline;
    }
    .markdown-content strong { font-weight: 600; }
    .markdown-content hr {
        border: none;
        border-top: 1px solid var(--border-color);
        margin: 0.75rem 0;
    }

    /* ─── Scroll to bottom ─── */
    .scroll-bottom-btn {
        position: absolute;
        bottom: 80px;
        right: 1.5rem;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: var(--shadow-md);
        opacity: 0;
        transition: opacity 0.3s, transform 0.2s;
        pointer-events: none;
        z-index: 10;
    }
    .scroll-bottom-btn.visible {
        opacity: 1;
        pointer-events: auto;
    }
    .scroll-bottom-btn:hover {
        transform: translateY(-2px);
        color: var(--color-primary);
    }

    /* ─── Responsive ─── */
    @@media (max-width: 767px) {
        .agent-layout {
            height: calc(100vh - 60px);
            border-radius: 0;
            border: none;
        }
        .agent-sidebar {
            position: absolute;
            z-index: 50;
            height: 100%;
            box-shadow: var(--shadow-lg);
        }
        .agent-sidebar.collapsed {
            width: 0;
            overflow: hidden;
        }
        .sidebar-toggle {
            display: flex;
        }
        .message-body { max-width: 85%; }
        .quick-action-chip { font-size: 0.75rem; padding: 0.25rem 0.5rem; }
        .chat-header { padding: 0.75rem 1rem; }
        .chat-history { padding: 1rem; }
        .chat-input-area { padding: 0.5rem 1rem; }
    }
    @@media (max-width: 991px) {
        .agent-sidebar {
            width: 220px;
        }
    }

    /* ─── Reduced motion ─── */
    @@media (prefers-reduced-motion: reduce) {
        .message { animation: none; }
        .typing-dot { animation: none; }
        .status-dot { animation: none; }
        .chat-history { scroll-behavior: auto; }
        .tool-spinner { animation: none; }
    }
</style>
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-11">
            <div class="agent-layout" id="agentLayout">
                <!-- Sidebar -->
                <div class="agent-sidebar" id="agentSidebar">
                    <div class="sidebar-header">
                        <button type="button" class="sidebar-new-btn" id="newChatBtn">
                            <i class="fas fa-plus"></i> New chat
                        </button>
                    </div>
                    <div class="sidebar-threads" id="sidebarThreads">
                        <div class="sidebar-empty" id="sidebarEmpty">
                            <i class="fas fa-comments"></i>
                            <div>No conversations yet</div>
                        </div>
                    </div>
                </div>
                <button type="button" class="sidebar-toggle" id="sidebarToggle">
                    <i class="fas fa-chevron-right"></i>
                </button>

                <!-- Main Chat Area -->
                <div class="agent-main">
                    <!-- Header -->
                    <div class="chat-header">
                        <div class="chat-header-left">
                            <button type="button" class="chat-header-btn d-lg-none" id="sidebarToggleBtn" title="Toggle sidebar">
                                <i class="fas fa-bars"></i>
                            </button>
                            <div class="chat-header-avatar">
                                <i class="fas fa-brain"></i>
                            </div>
                            <div>
                                <h5 class="chat-header-title">Garamatic AI</h5>
                                <p class="chat-header-subtitle">Qwen 3.5 · 2B · Ollama</p>
                            </div>
                        </div>
                        <div class="chat-header-actions">
                            @if (hasTicket)
                            {
                                <span class="badge bg-white text-primary">
                                    <i class="fas fa-ticket-alt me-1"></i> #@ViewBag.TicketId.ToString().Substring(0, 8)
                                </span>
                            }
                            <div class="model-switcher" title="Switch model">
                                <i class="fas fa-microchip"></i>
                                <select id="modelSelect">
                                    <option value="@ViewBag.FastModel">Fast (@ViewBag.FastModel)</option>
                                    <option value="@ViewBag.QualityModel">Quality (@ViewBag.QualityModel)</option>
                                </select>
                            </div>
                            <div class="chat-header-status">
                                <span class="status-dot"></span>
                                <span>Online</span>
                            </div>
                            <button type="button" class="chat-header-btn" id="exportBtn" title="Export chat">
                                <i class="fas fa-download"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="quick-actions">
                        <div class="quick-actions-label">Quick actions</div>
                        <div class="d-flex flex-wrap">
                            <button type="button" class="quick-action-chip" data-prompt="What tickets does alice@example.com have?">
                                <i class="fas fa-search"></i> Customer tickets
                            </button>
                            <button type="button" class="quick-action-chip" data-prompt="Show me Alice Johnson's full context">
                                <i class="fas fa-user"></i> Customer context
                            </button>
                            <button type="button" class="quick-action-chip" data-prompt="Create a €200 invoice for ticket #123">
                                <i class="fas fa-file-invoice"></i> Create invoice
                            </button>
                            <button type="button" class="quick-action-chip" data-prompt="What is the invoice status for ticket #123?">
                                <i class="fas fa-check-circle"></i> Invoice status
                            </button>
                            @if (hasTicket)
                            {
                                <button type="button" class="quick-action-chip" data-prompt="I'm looking at ticket #@ViewBag.TicketId. What can you tell me about it?">
                                    <i class="fas fa-ticket-alt"></i> This ticket
                                </button>
                                <button type="button" class="quick-action-chip" data-prompt="Create an invoice for ticket #@ViewBag.TicketId with amount €150">
                                    <i class="fas fa-euro-sign"></i> Invoice this ticket
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Chat History -->
                    <div class="chat-history" id="chatHistory">
                        <div class="chat-empty" id="chatEmpty">
                            <div class="chat-empty-icon">
                                <i class="fas fa-robot"></i>
                            </div>
                            <div class="chat-empty-title">How can I help you today?</div>
                            <div class="chat-empty-text">
                                I can look up tickets, check customer context, create invoices, and send emails.
                                Use the quick actions above or type your question below.
                            </div>
                        </div>
                    </div>

                    <!-- Scroll to bottom -->
                    <button type="button" class="scroll-bottom-btn" id="scrollBottomBtn" title="Scroll to bottom">
                        <i class="fas fa-chevron-down"></i>
                    </button>

                    <!-- Input Area -->
                    <div class="chat-input-area">
                        <div class="chat-input-wrapper">
                            <textarea
                                id="chatInput"
                                class="chat-input"
                                placeholder="Ask the agent..."
                                rows="1"
                                autocomplete="off"
                            ></textarea>
                            <button type="button" class="chat-send-btn" id="sendBtn" title="Send (Ctrl+Enter)">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                        <div class="chat-toolbar">
                            <div class="chat-toolbar-left">
                                <span><kbd>Ctrl</kbd>+<kbd>Enter</kbd> to send</span>
                                <span class="chat-toolbar-divider"></span>
                                <button type="button" class="chat-toolbar-btn" id="clearChat">
                                    <i class="fas fa-trash-alt me-1"></i> Clear
                                </button>
                            </div>
                            <span id="modelStatus">qwen3.5:2b-q4_K_M</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/marked@11.1.1/marked.min.js"></script>
<script>
    // ─── Elements ───
    const chatHistory = document.getElementById('chatHistory');
    const chatInput = document.getElementById('chatInput');
    const sendBtn = document.getElementById('sendBtn');
    const scrollBottomBtn = document.getElementById('scrollBottomBtn');
    const sidebarThreads = document.getElementById('sidebarThreads');
    const sidebarEmpty = document.getElementById('sidebarEmpty');
    const agentSidebar = document.getElementById('agentSidebar');
    const sidebarToggleBtn = document.getElementById('sidebarToggleBtn');
    const chatSidebarToggle = document.getElementById('sidebarToggle');

    // ─── State ───
    const ticketId = '@(ViewBag.TicketId?.ToString() ?? "")';
    const agenticUrl = window.__AGENTIC_URL__ || 'http://localhost:3001';
    let currentThreadId = localStorage.getItem('agentchat_thread_id') || ('web-' + Math.random().toString(36).slice(2, 10));
    let isTyping = false;
    let currentEventSource = null;
    let activeToolIndicators = {};
    let messages = []; // Local message history for export
    let selectedModel = document.getElementById('modelSelect').value;

    // Save thread ID
    localStorage.setItem('agentchat_thread_id', currentThreadId);

    // ─── Model switcher ───
    const modelSelect = document.getElementById('modelSelect');
    const modelSubtitle = document.querySelector('.chat-header-subtitle');
    const modelStatus = document.getElementById('modelStatus');
    if (modelSelect) {
        modelSelect.addEventListener('change', () => {
            selectedModel = modelSelect.value;
            const label = modelSelect.options[modelSelect.selectedIndex].text.split('(')[0].trim();
            if (modelSubtitle) {
                modelSubtitle.textContent = label + ' · ' + selectedModel;
            }
            if (modelStatus) {
                modelStatus.textContent = selectedModel;
            }
        });
    }

    // ─── Auto-resize textarea ───
    chatInput.addEventListener('input', () => {
        chatInput.style.height = 'auto';
        chatInput.style.height = Math.min(chatInput.scrollHeight, 120) + 'px';
    });

    // ─── Scroll to bottom ───
    chatHistory.addEventListener('scroll', () => {
        const nearBottom = chatHistory.scrollHeight - chatHistory.scrollTop - chatHistory.clientHeight < 100;
        scrollBottomBtn.classList.toggle('visible', !nearBottom);
    });
    scrollBottomBtn.addEventListener('click', () => {
        chatHistory.scrollTo({ top: chatHistory.scrollHeight, behavior: 'smooth' });
    });
    function scrollToBottom() {
        chatHistory.scrollTo({ top: chatHistory.scrollHeight, behavior: 'smooth' });
    }

    // ─── Timestamp ───
    function formatTime() {
        return new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });
    }
    function formatDate(ts) {
        if (!ts) return '';
        const d = new Date(ts * 1000);
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    // ─── Render Markdown ───
    function renderMarkdown(text) {
        if (typeof marked === 'undefined') return escapeHtml(text);
        try {
            const raw = marked.parse(text);
            const template = document.createElement('template');
            template.innerHTML = raw;
            const content = template.content;
            content.querySelectorAll('script').forEach(el => el.remove());
            content.querySelectorAll('*').forEach(el => {
                Array.from(el.attributes).forEach(attr => {
                    if (attr.name.startsWith('on')) el.removeAttribute(attr.name);
                });
                if (el.tagName === 'A') {
                    const href = el.getAttribute('href');
                    if (href && (/^javascript:/i.test(href) || /^data:/i.test(href))) {
                        el.removeAttribute('href');
                    }
                }
            });
            const wrapper = document.createElement('div');
            wrapper.appendChild(content.cloneNode(true));
            return wrapper.innerHTML;
        } catch (e) {
            return escapeHtml(text);
        }
    }
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // ─── Add Message ───
    function addMessage(role, text, skipHistory = false) {
        const emptyState = document.getElementById('chatEmpty');
        if (emptyState) emptyState.style.display = 'none';

        if (!skipHistory) {
            messages.push({ role, content: text, time: new Date().toISOString() });
        }

        const isUser = role === 'user';
        const messageDiv = document.createElement('div');
        messageDiv.className = 'message';
        messageDiv.dataset.role = role;
        messageDiv.innerHTML = `
            <div class="message-avatar ${isUser ? 'user' : 'agent'}">
                <i class="fas ${isUser ? 'fa-user' : 'fa-robot'}"></i>
            </div>
            <div class="message-body ${isUser ? 'user' : ''}">
                <div class="message-bubble ${isUser ? 'user' : 'agent'}">
                    <div class="markdown-content">${renderMarkdown(text)}</div>
                </div>
                <div class="message-meta">
                    <span>${isUser ? 'You' : 'Garamatic AI'}</span>
                    <span>${formatTime()}</span>
                    ${!isUser ? `<span class="message-copy" title="Copy to clipboard"><i class="fas fa-copy"></i></span>` : ''}
                </div>
            </div>
        `;
        chatHistory.appendChild(messageDiv);
        scrollToBottom();

        const copyBtn = messageDiv.querySelector('.message-copy');
        if (copyBtn) {
            copyBtn.addEventListener('click', () => {
                navigator.clipboard.writeText(text).then(() => {
                    copyBtn.classList.add('copied');
                    copyBtn.innerHTML = '<i class="fas fa-check"></i>';
                    setTimeout(() => {
                        copyBtn.classList.remove('copied');
                        copyBtn.innerHTML = '<i class="fas fa-copy"></i>';
                    }, 2000);
                });
            });
        }
        return messageDiv;
    }

    // ─── Tool Indicator ───
    function addToolIndicator(tool) {
        const id = 'tool-' + tool + '-' + Date.now();
        const div = document.createElement('div');
        div.id = id;
        div.className = 'tool-indicator';
        div.innerHTML = `
            <div class="tool-spinner"></div>
            <i class="fas fa-cogs"></i>
            <span>Using <strong>${tool}</strong>...</span>
        `;
        chatHistory.appendChild(div);
        scrollToBottom();
        activeToolIndicators[tool] = id;
        return id;
    }
    function markToolDone(tool) {
        const id = activeToolIndicators[tool];
        if (!id) return;
        const el = document.getElementById(id);
        if (el) {
            el.classList.add('done');
            el.innerHTML = `<i class="fas fa-check"></i> <span><strong>${tool}</strong> done</span>`;
        }
        delete activeToolIndicators[tool];
    }
    function clearActiveTools() {
        Object.values(activeToolIndicators).forEach(id => {
            const el = document.getElementById(id);
            if (el) el.remove();
        });
        activeToolIndicators = {};
    }

    // ─── Typing Indicator ───
    function addTyping() {
        const id = 'typing-' + Date.now();
        const div = document.createElement('div');
        div.id = id;
        div.className = 'typing-indicator';
        div.innerHTML = `
            <div class="message-avatar agent">
                <i class="fas fa-robot"></i>
            </div>
            <div class="message-body">
                <div class="typing-dots">
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                </div>
                <div class="typing-label">Thinking...</div>
            </div>
        `;
        chatHistory.appendChild(div);
        scrollToBottom();
        return id;
    }
    function removeTyping(id) {
        const el = document.getElementById(id);
        if (el) el.remove();
    }

    // ─── Send Message (Streaming) ───
    async function sendMessage(message) {
        if (isTyping) return;
        isTyping = true;
        sendBtn.disabled = true;
        clearActiveTools();

        // Abort any existing stream
        if (currentEventSource) {
            currentEventSource.close();
            currentEventSource = null;
        }

        const typingId = addTyping();
        let currentAgentBubble = null;
        let currentAgentText = '';

        try {
            const response = await fetch(`${agenticUrl}/agent/chat/stream`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message, thread_id: currentThreadId, model: selectedModel })
            });

            removeTyping(typingId);

            if (!response.ok) {
                const err = await response.json().catch(() => ({}));
                const msg = err.detail?.error || err.error || 'The agent is unavailable.';
                addMessage('agent', '⚠️ ' + msg);
                return;
            }

            // Read the SSE stream
            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            let buffer = '';

            while (true) {
                const { done, value } = await reader.read();
                if (done) break;

                buffer += decoder.decode(value, { stream: true });
                const lines = buffer.split('\n\n');
                buffer = lines.pop() || '';

                for (const chunk of lines) {
                    if (!chunk.trim()) continue;
                    const eventMatch = chunk.match(/^event: (.+)$/m);
                    const dataMatch = chunk.match(/^data: (.+)$/m);
                    if (!eventMatch || !dataMatch) continue;

                    const eventType = eventMatch[1];
                    const eventData = JSON.parse(dataMatch[1]);

                    handleStreamEvent(eventType, eventData, currentAgentBubble, currentAgentText,
                        (bubble) => { currentAgentBubble = bubble; },
                        (text) => { currentAgentText = text; });
                }
            }

            // Handle remaining buffer
            if (buffer.trim()) {
                const eventMatch = buffer.match(/^event: (.+)$/m);
                const dataMatch = buffer.match(/^data: (.+)$/m);
                if (eventMatch && dataMatch) {
                    const eventData = JSON.parse(dataMatch[1]);
                    handleStreamEvent(eventMatch[1], eventData, currentAgentBubble, currentAgentText,
                        (bubble) => { currentAgentBubble = bubble; },
                        (text) => { currentAgentText = text; });
                }
            }

        } catch (e) {
            removeTyping(typingId);
            clearActiveTools();
            addMessage('agent', '⚠️ Failed to reach the agent. ' + e.message);
        } finally {
            isTyping = false;
            sendBtn.disabled = false;
            chatInput.focus();
            // Refresh thread list
            loadThreads();
        }
    }

    function handleStreamEvent(type, data, currentBubble, currentText, setBubble, setText) {
        switch (type) {
            case 'tool_call':
                addToolIndicator(data.tool);
                break;
            case 'tool_result':
                markToolDone(data.tool);
                break;
            case 'content':
                if (!currentBubble) {
                    currentBubble = addMessage('agent', data.text, true);
                    setBubble(currentBubble);
                } else {
                    const contentDiv = currentBubble.querySelector('.markdown-content');
                    if (contentDiv) {
                        contentDiv.innerHTML = renderMarkdown(data.text);
                    }
                }
                setText(data.text);
                break;
            case 'error':
                clearActiveTools();
                addMessage('agent', '⚠️ ' + (data.error || 'Unknown error'));
                break;
            case 'done':
                clearActiveTools();
                // Final content already rendered
                break;
        }
        scrollToBottom();
    }

    // ─── Submit handler ───
    function submit() {
        const text = chatInput.value.trim();
        if (!text || isTyping) return;
        addMessage('user', text);
        chatInput.value = '';
        chatInput.style.height = 'auto';
        sendMessage(text);
    }

    // ─── Event listeners ───
    sendBtn.addEventListener('click', submit);
    chatInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey) && !e.shiftKey) {
            e.preventDefault();
            submit();
        }
    });

    // Quick actions
    document.querySelectorAll('.quick-action-chip').forEach(btn => {
        btn.addEventListener('click', () => {
            const prompt = btn.dataset.prompt;
            if (!prompt) return;
            addMessage('user', prompt);
            sendMessage(prompt);
        });
    });

    // Clear chat
    document.getElementById('clearChat').addEventListener('click', () => {
        chatHistory.innerHTML = `
            <div class="chat-empty">
                <div class="chat-empty-icon"><i class="fas fa-robot"></i></div>
                <div class="chat-empty-title">Chat cleared</div>
                <div class="chat-empty-text">Ask me about tickets, customers, or invoices.</div>
            </div>
        `;
        messages = [];
    });

    // Export chat
    document.getElementById('exportBtn').addEventListener('click', () => {
        if (messages.length === 0) {
            alert('No messages to export.');
            return;
        }
        let md = `# Garamatic AI Chat\n\n**Thread:** ${currentThreadId}\n**Date:** ${new Date().toLocaleString()}\n\n---\n\n`;
        messages.forEach(m => {
            const role = m.role === 'user' ? '**You**' : '**Garamatic AI**';
            md += `${role} (${new Date(m.time).toLocaleTimeString()}):\n\n${m.content}\n\n---\n\n`;
        });
        const blob = new Blob([md], { type: 'text/markdown' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `garamatic-chat-${currentThreadId}.md`;
        a.click();
        URL.revokeObjectURL(url);
    });

    // ─── Sidebar: Thread Management ───
    async function loadThreads() {
        try {
            const resp = await fetch(`${agenticUrl}/agent/threads`);
            if (!resp.ok) return;
            const data = await resp.json();
            const threads = data.threads || [];
            renderThreadList(threads);
        } catch (e) {
            console.warn('Failed to load threads:', e);
        }
    }

    function renderThreadList(threads) {
        if (threads.length === 0) {
            sidebarThreads.innerHTML = `
                <div class="sidebar-empty" id="sidebarEmpty">
                    <i class="fas fa-comments"></i>
                    <div>No conversations yet</div>
                </div>
            `;
            return;
        }

        sidebarThreads.innerHTML = '';
        threads.forEach(t => {
            const div = document.createElement('div');
            div.className = 'thread-item' + (t.thread_id === currentThreadId ? ' active' : '');
            div.dataset.threadId = t.thread_id;
            div.innerHTML = `
                <div class="thread-title">${escapeHtml(t.title || 'New conversation')}</div>
                <div class="thread-meta">
                    <span>${formatDate(t.updated_at)}</span>
                    <span>·</span>
                    <span>${t.message_count || 0} msg</span>
                </div>
                <button class="thread-delete" title="Delete" data-thread-id="${t.thread_id}">
                    <i class="fas fa-times"></i>
                </button>
            `;
            div.addEventListener('click', (e) => {
                if (e.target.closest('.thread-delete')) return;
                switchToThread(t.thread_id);
            });
            const delBtn = div.querySelector('.thread-delete');
            delBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                deleteThread(t.thread_id);
            });
            sidebarThreads.appendChild(div);
        });
    }

    async function switchToThread(threadId) {
        if (isTyping) return;
        currentThreadId = threadId;
        localStorage.setItem('agentchat_thread_id', threadId);
        messages = [];

        // Clear chat area
        chatHistory.innerHTML = `
            <div class="chat-empty">
                <div class="chat-empty-icon"><i class="fas fa-robot"></i></div>
                <div class="chat-empty-title">Loading conversation...</div>
                <div class="chat-empty-text">Please wait while I retrieve the chat history.</div>
            </div>
        `;

        // Load messages
        try {
            const resp = await fetch(`${agenticUrl}/agent/threads/${encodeURIComponent(threadId)}`);
            if (resp.ok) {
                const data = await resp.json();
                const msgs = data.messages || [];
                chatHistory.innerHTML = '';
                if (msgs.length === 0) {
                    chatHistory.innerHTML = `
                        <div class="chat-empty">
                            <div class="chat-empty-icon"><i class="fas fa-robot"></i></div>
                            <div class="chat-empty-title">New conversation</div>
                            <div class="chat-empty-text">Ask me about tickets, customers, or invoices.</div>
                        </div>
                    `;
                } else {
                    msgs.forEach(m => {
                        addMessage(m.role, m.content, false);
                    });
                }
            }
        } catch (e) {
            chatHistory.innerHTML = `
                <div class="chat-empty">
                    <div class="chat-empty-icon"><i class="fas fa-robot"></i></div>
                    <div class="chat-empty-title">Error loading chat</div>
                    <div class="chat-empty-text">Could not load conversation history.</div>
                </div>
            `;
        }

        // Update sidebar active state
        renderThreadList(Array.from(sidebarThreads.querySelectorAll('.thread-item')).map(el => ({
            thread_id: el.dataset.threadId,
            title: el.querySelector('.thread-title').textContent,
            updated_at: 0,
            message_count: 0
        })));
        loadThreads();
    }

    async function deleteThread(threadId) {
        if (!confirm('Delete this conversation?')) return;
        try {
            const resp = await fetch(`${agenticUrl}/agent/threads/${encodeURIComponent(threadId)}`, {
                method: 'DELETE'
            });
            if (resp.ok) {
                if (threadId === currentThreadId) {
                    startNewChat();
                } else {
                    loadThreads();
                }
            }
        } catch (e) {
            console.warn('Failed to delete thread:', e);
        }
    }

    function startNewChat() {
        if (isTyping) return;
        currentThreadId = 'web-' + Math.random().toString(36).slice(2, 10);
        localStorage.setItem('agentchat_thread_id', currentThreadId);
        messages = [];
        chatHistory.innerHTML = `
            <div class="chat-empty">
                <div class="chat-empty-icon"><i class="fas fa-robot"></i></div>
                <div class="chat-empty-title">New conversation</div>
                <div class="chat-empty-text">Ask me about tickets, customers, or invoices.</div>
            </div>
        `;
        loadThreads();
    }

    document.getElementById('newChatBtn').addEventListener('click', startNewChat);

    // ─── Mobile sidebar toggle ───
    function toggleSidebar() {
        agentSidebar.classList.toggle('collapsed');
        const icon = chatSidebarToggle.querySelector('i');
        if (agentSidebar.classList.contains('collapsed')) {
            icon.className = 'fas fa-chevron-right';
        } else {
            icon.className = 'fas fa-chevron-left';
        }
    }
    if (sidebarToggleBtn) sidebarToggleBtn.addEventListener('click', toggleSidebar);
    if (chatSidebarToggle) chatSidebarToggle.addEventListener('click', toggleSidebar);

    // ─── Pre-seed ticket context ───
    if (ticketId) {
        const emptyState = document.getElementById('chatEmpty');
        if (emptyState) {
            emptyState.querySelector('.chat-empty-title').textContent = 'Loading ticket context...';
            emptyState.querySelector('.chat-empty-text').textContent = 'Analyzing ticket #' + ticketId.substring(0, 8) + '...';
        }
        const contextMsg = `I'm looking at ticket #${ticketId}. What can you tell me about it?`;
        addMessage('user', contextMsg);
        sendMessage(contextMsg);
    }

    // ─── Init ───
    loadThreads();
</script>
}
