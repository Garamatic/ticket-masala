{
    "Masala": {
        "ConfigPath": "./config",
        "Database": {
            "Provider": "Sqlite",
            "ConnectionString": "Data Source=app.db"
        },
        "Gerda": {
            "Enabled": true,
            "ModelPath": "./models",
            "OpenAiModel": "openai/gpt-4o-mini"
        },
        "Features": {
            "TicketGenerator": false,
            "TicketGeneratorIntervalSeconds": 30,
            "EmailNotifications": false,
            "KnowledgeBase": true
        }
    },
    "OpenAI": {
        "ApiKey": "",
        "BaseUrl": "https://openrouter.ai/api/v1"
    },
    "DatabaseProvider": "Sqlite",
    "ConnectionStrings": {
        "DefaultConnection": "Data Source=app.db"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "TicketGenerator": {
        "Enabled": true,
        "IntervalSeconds": 30
    }
}