@{
    ViewData["Title"] = "AI Agent";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-robot me-2"></i>
                        Garamatic AI Agent
                    </h5>
                </div>
                <div class="card-body d-flex flex-column" style="height: 70vh;">
                    <div id="chatHistory" class="flex-grow-1 overflow-auto mb-3" style="background: #f8f9fa; border-radius: 0.375rem; padding: 1rem;">
                        <div class="text-muted text-center small mb-2">
                            Ask me about tickets, customers, or invoices.
                        </div>
                        <div class="text-muted text-center small">
                            Examples: "What tickets does alice@example.com have?" or "Create a €200 invoice for ticket #123"
                        </div>
                    </div>
                    <form id="chatForm" class="d-flex gap-2">
                        <input type="text" id="chatInput" class="form-control" placeholder="Ask the agent..." autocomplete="off" required />
                        <button type="submit" class="btn btn-primary" id="sendBtn">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const chatHistory = document.getElementById('chatHistory');
    const chatForm = document.getElementById('chatForm');
    const chatInput = document.getElementById('chatInput');
    const sendBtn = document.getElementById('sendBtn');
    const threadId = 'web-' + Math.random().toString(36).slice(2, 10);
    const agenticUrl = 'http://localhost:3001';

    function addMessage(role, text) {
        const div = document.createElement('div');
        div.className = 'mb-2';
        const isUser = role === 'user';
        div.innerHTML = `
            <div class="d-flex ${isUser ? 'justify-content-end' : 'justify-content-start'}">
                <div class="${isUser ? 'bg-primary text-white' : 'bg-white border'} rounded px-3 py-2" style="max-width: 80%;">
                    <div class="small ${isUser ? '' : 'text-muted'} mb-1">
                        <i class="fas ${isUser ? 'fa-user' : 'fa-robot'} me-1"></i>
                        ${isUser ? 'You' : 'Agent'}
                    </div>
                    <div style="white-space: pre-wrap;">${escapeHtml(text)}</div>
                </div>
            </div>
        `;
        chatHistory.appendChild(div);
        chatHistory.scrollTop = chatHistory.scrollHeight;
    }

    function addLoading() {
        const id = 'loading-' + Date.now();
        const div = document.createElement('div');
        div.id = id;
        div.className = 'mb-2';
        div.innerHTML = `
            <div class="d-flex justify-content-start">
                <div class="bg-white border rounded px-3 py-2">
                    <div class="small text-muted mb-1">
                        <i class="fas fa-robot me-1"></i> Agent
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span class="small text-muted">Thinking...</span>
                    </div>
                </div>
            </div>
        `;
        chatHistory.appendChild(div);
        chatHistory.scrollTop = chatHistory.scrollHeight;
        return id;
    }

    function removeLoading(id) {
        const el = document.getElementById(id);
        if (el) el.remove();
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    async function sendMessage(message) {
        const loadingId = addLoading();
        sendBtn.disabled = true;

        try {
            const response = await fetch(`${agenticUrl}/agent/chat`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message, thread_id: threadId })
            });

            removeLoading(loadingId);

            if (!response.ok) {
                const err = await response.json().catch(() => ({}));
                addMessage('agent', err.detail?.message || err.error || 'The agent is unavailable. Is OPENAI_API_KEY set?');
                return;
            }

            const data = await response.json();
            addMessage('agent', data.response);
        } catch (e) {
            removeLoading(loadingId);
            addMessage('agent', 'Failed to reach the agent. Make sure the agentic service is running at ' + agenticUrl);
        } finally {
            sendBtn.disabled = false;
            chatInput.focus();
        }
    }

    chatForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = chatInput.value.trim();
        if (!text) return;
        addMessage('user', text);
        chatInput.value = '';
        sendMessage(text);
    });
</script>
}
